# ─── Secrets — never commit these ────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# uv
# Keep pyproject.toml and uv.lock in git — they pin exact versions.
# Only ignore the local cache directory.
.uv/

# ─── Model files ──────────────────────────────────────────────────────────────
# .pkl and .pt files ARE committed — Render needs them to place bets.
# Our models are small (~5MB total). Large models (>100MB) should use
# Supabase Storage instead and be downloaded at runtime.
*.joblib
*.onnx
*.pth

# ─── Node / Next.js ──────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/

# Next.js build output
frontend/.next/
frontend/out/

# npm / yarn / pnpm lockfiles for local installs
# (keep package.json, but ignore platform-specific lock noise)
.pnp/
.pnp.js

# ─── Testing ─────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Jupyter (if used for EDA) ───────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Temporary / scratch files ───────────────────────────────────────────────
*.tmp
*.bak
scratch/