# =============================================================================
# .env.example — copy this to .env and fill in your values
# NEVER commit .env to git. It's in .gitignore already.
# =============================================================================

# --- Supabase ---
# Get these from: https://app.supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJh...          # Safe to use in the frontend (read-only via RLS)
SUPABASE_SERVICE_KEY=eyJh...       # Backend only — bypasses RLS, NEVER expose publicly

# --- football-data.org ---
# Free tier: https://www.football-data.org/client/register
# PL competition code: PL
FOOTBALL_DATA_API_KEY=your_key_here

# --- The Odds API ---
# Free tier (500 requests/month): https://the-odds-api.com
THE_ODDS_API_KEY=your_key_here

# --- Render (Python backend) ---
# Set this in Render's environment variables dashboard, not here.
# RENDER_SERVICE_URL=https://pl-betting-bot-api.onrender.com

# --- GitHub Actions ---
# Add all the above as Repository Secrets in:
# GitHub → Your Repo → Settings → Secrets and variables → Actions
